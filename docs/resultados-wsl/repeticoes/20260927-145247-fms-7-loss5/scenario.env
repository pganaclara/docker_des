# As fms-7, with every node dropping 5 % of the frames it receives (the
# engine's DES_SIMULATE_LOSS_PCT; works on any kernel, unlike netem). The
# protocol retransmits; duplicates are recognised by sequence number, so the
# cryptographic work must be exactly that of a loss-free run.
DES_PROBLEM=fms
DES_NUM_NODES=7
DES_FAMILY=LMOD
DES_ROUNDS=5
DES_WORK_MS=0
DES_TRANSPORT=multicast
DES_NETEM=
DES_EXTRA_FLAGS=-DDES_SIMULATE_LOSS_PCT=5
DES_TAG_SUFFIX=-loss5

EXPECT_DEC_TOTAL=798
EXPECT_DEC_CYCLE1_TOTAL=190
EXPECT_OUTCOME=complete
