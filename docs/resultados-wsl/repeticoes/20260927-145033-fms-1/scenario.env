# FMS in ONE container holding all 7 supervisors: the software counterpart of
# the single-board sketch. No network traffic at all (every event is local).
# Cycle 1 must cost 190 decryptions, the single-board figure for the
# local-modular family (esp32_crypto README, benchmark table), and the whole
# run the 798 the distributed runs split between their nodes.
DES_PROBLEM=fms
DES_NUM_NODES=1
DES_FAMILY=LMOD
DES_ROUNDS=5
DES_WORK_MS=0
DES_TRANSPORT=multicast
DES_NETEM=

EXPECT_DEC_TOTAL=798
EXPECT_DEC_CYCLE1_TOTAL=190
EXPECT_OUTCOME=complete
