# FMS on 2 containers: node 1 = S0..S3, node 2 = S4..S6 — the same partition as
# the two ESP32-S3 boards in esp32_crypto (3rd run: LMOD, DES_WORK_MS 0).
# Expected, if the container runs the same engine: fingerprint edbd7971,
# 220/220 steps, decryptions 405 + 393 (85 + 105 in cycle 1).
DES_PROBLEM=fms
DES_NUM_NODES=2
DES_FAMILY=LMOD
DES_ROUNDS=5
DES_WORK_MS=0
DES_TRANSPORT=multicast
DES_NETEM=

# Expected values, checked by scripts/summarize.py. They come from the two
# ESP32-S3 boards (esp32_crypto/des_distributed/README.md, "Verification
# status"): the container must reproduce them to count as the same system.
EXPECT_FINGERPRINT=edbd7971
EXPECT_DEC_PER_NODE="405 393"
EXPECT_DEC_CYCLE1_PER_NODE="85 105"
EXPECT_OUTCOME=complete
