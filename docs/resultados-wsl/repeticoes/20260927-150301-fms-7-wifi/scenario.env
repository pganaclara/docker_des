# As fms-7, with each container's egress shaped by netem like a Wi-Fi hop:
# 7 ms +- 3 ms one way (the ESP32 testbed measured ~14 ms round trip) and 1 %
# loss, so retransmission is exercised. Needs the host kernel's sch_netem
# (check: zcat /proc/config.gz | grep NETEM). Where it is missing, use
# fms-7-loss5.env, which injects loss inside the engine instead.
DES_PROBLEM=fms
DES_NUM_NODES=7
DES_FAMILY=LMOD
DES_ROUNDS=5
DES_WORK_MS=0
DES_TRANSPORT=multicast
DES_NETEM="delay 7ms 3ms loss 1%"

# Expected values, checked by scripts/summarize.py. Each supervisor's
# decryptions do not depend on where it runs, so the cell as a whole must do
# the work the ESP32 boards did: 405 + 393 = 798 over 5 cycles, and 190 in
# cycle 1 (= the single-board figure). Distributing splits the work; it must
# not add to it.
EXPECT_DEC_TOTAL=798
EXPECT_DEC_CYCLE1_TOTAL=190
EXPECT_OUTCOME=complete
