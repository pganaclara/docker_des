# FMS em 1 container(s): S0..S6 num container só (o equivalente da placa única).
# Faz parte da varredura 1..7 (scripts/run-all.sh). Cada decifração leva
# 69 ms, como no ESP32-S3 (DES_EMU_SCALARMUL_MS, padrão do compose.yaml).
DES_PROBLEM=fms
DES_NUM_NODES=1
DES_FAMILY=LMOD
DES_ROUNDS=5
DES_WORK_MS=0

# Invariantes (conferidos por scripts/summarize.py): cada supervisor faz as
# mesmas decifrações onde quer que rode, então a célula inteira faz sempre
# 798 (190 no ciclo 1), com qualquer número de nós.
EXPECT_DEC_TOTAL=798
EXPECT_DEC_CYCLE1_TOTAL=190
EXPECT_OUTCOME=complete
EXPECT_FINGERPRINT=3f2beff2
