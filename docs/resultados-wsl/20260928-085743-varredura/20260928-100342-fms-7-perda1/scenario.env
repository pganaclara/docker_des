# Robustez a perda: FMS em 7 containers, 1 % dos quadros recebidos descartados.
#   partição: um supervisor por nó
# A perda é injetada pelo próprio motor (DES_SIMULATE_LOSS_PCT), DEPOIS da
# autenticação: o quadro chegou, mas é descartado como se tivesse sumido na
# rede, e quem enviou precisa retransmitir. Sorteio novo a cada execução e em
# cada nó (semente no log; DES_LOSS_SEED a fixa). Decifração emulada a 69 ms
# e os timeouts do motor (1,5 s) como no ESP32.
#   scripts/run-all.sh perda
#
# O resultado é aleatório: a execução pode completar, parar em SAFE HALT ou
# terminar com passos pulados. O que NÃO pode acontecer em nenhum caso é
# divergência: dois nós aplicarem sequências diferentes dos eventos que
# compartilham (verificação "consistência entre nós" do summarize.py), ou o
# oráculo homomórfico falhar.
DES_PROBLEM=fms
DES_NUM_NODES=7
DES_FAMILY=LMOD
DES_ROUNDS=5
DES_WORK_MS=0
DES_EXTRA_FLAGS=-DDES_SIMULATE_LOSS_PCT=1
DES_TAG_SUFFIX=-perda1

EXPECT_OUTCOME=complete|halt|incomplete
EXPECT_FINGERPRINT=04511541
# Só conferido quando a execução completa: sem pulos, as mesmas decifrações.
EXPECT_DEC_TOTAL=798
EXPECT_DEC_CYCLE1_TOTAL=190
