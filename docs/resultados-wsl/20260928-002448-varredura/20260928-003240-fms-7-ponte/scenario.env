# Teste de sobrecarga do container: FMS em 7 nó(s), modo ponte.
#   containers na rede bridge "cell" (como a varredura principal)
# Os três modos (ponte, host, nativo) usam a MESMA imagem, com binários
# estáticos e -DDES_MCAST_LOOP=1 (com vários nós numa só interface, sem o
# loop nenhum ouve os outros). Só muda onde os processos rodam.
#   partição: um supervisor por nó
#   scripts/run-all.sh sobrecarga
DES_PROBLEM=fms
DES_NUM_NODES=7
DES_FAMILY=LMOD
DES_ROUNDS=5
DES_WORK_MS=0
DES_EXTRA_FLAGS="-static -DDES_MCAST_LOOP=1"
DES_TAG_SUFFIX=-sobrecarga
DES_MODE=ponte

# Invariantes: os mesmos da varredura principal, em qualquer modo.
EXPECT_DEC_TOTAL=798
EXPECT_DEC_CYCLE1_TOTAL=190
EXPECT_OUTCOME=complete
EXPECT_FINGERPRINT=04511541
