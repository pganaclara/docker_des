# FMS em 6 containers com o supervisor S5 ISOLADO num container só; os outros
# 6 distribuídos para minimizar as decifrações do container mais carregado no
# ciclo 1 (contagens por supervisor medidas com 7 containers).
#   partição: S0 S2 · S1 · S3 · S4 · S6 · S5
# Compare com scenarios/fms-6.env (blocos contíguos): scripts/run-all.sh s5
DES_PROBLEM=fms
DES_NUM_NODES=6
DES_FAMILY=LMOD
DES_ROUNDS=5
DES_WORK_MS=0
DES_EXTRA_FLAGS="-DDES_SUP_NODE_MAP={1,2,1,3,4,6,5}"
DES_TAG_SUFFIX=-s5

# Invariantes: a partição muda quem faz cada decifração, não quantas são.
EXPECT_DEC_TOTAL=798
EXPECT_DEC_CYCLE1_TOTAL=190
EXPECT_OUTCOME=complete
