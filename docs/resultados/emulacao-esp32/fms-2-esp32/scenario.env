# ESP32 EMULATION, 2 node(s): as fms-2, with every decryption made to take
# 69 ms — one blinded scalar multiplication on an ESP32-S3 (esp32_crypto,
# measured). Tests the explanation in docs/arquitetura.md §6.3: when
# cryptography costs what it costs on the board, distributing should speed the
# cell up again, as it did on the boards (1 board 346.0 ms/step, 2 boards
# 296.9 in cycle 1). The logical results must not change.
DES_PROBLEM=fms
DES_NUM_NODES=2
DES_FAMILY=LMOD
DES_ROUNDS=5
DES_WORK_MS=0
DES_TRANSPORT=multicast
DES_NETEM=
DES_EMU_SCALARMUL_MS=69

EXPECT_FINGERPRINT=edbd7971
EXPECT_DEC_PER_NODE="405 393"
EXPECT_DEC_CYCLE1_PER_NODE="85 105"
EXPECT_OUTCOME=complete
