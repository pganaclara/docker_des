# As fms-7, over UDP UNICAST (one datagram per peer, names resolved by Docker
# DNS) — the binding for networks without multicast (Swarm overlay, Kubernetes).
DES_PROBLEM=fms
DES_NUM_NODES=7
DES_FAMILY=LMOD
DES_ROUNDS=5
DES_WORK_MS=0
DES_TRANSPORT=unicast
DES_NETEM=

# Expected values, checked by scripts/summarize.py. Each supervisor's
# decryptions do not depend on where it runs, so the cell as a whole must do
# the work the ESP32 boards did: 405 + 393 = 798 over 5 cycles, and 190 in
# cycle 1 (= the single-board figure). Distributing splits the work; it must
# not add to it.
EXPECT_DEC_TOTAL=798
EXPECT_DEC_CYCLE1_TOTAL=190
EXPECT_OUTCOME=complete
