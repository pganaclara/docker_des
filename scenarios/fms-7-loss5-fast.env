# As fms-7-loss5, with the protocol's timeouts cut from 1500 ms to 100 ms.
# The engine's defaults are sized for the ESP32, where a participant can be
# busy for 3-4 s inside one homomorphic step; in a container a step takes
# about a millisecond, so a lost frame need not cost 1.5 s. Compare the time
# per step with fms-7-loss5: same loss, same work, only the timeouts differ.
DES_PROBLEM=fms
DES_NUM_NODES=7
DES_FAMILY=LMOD
DES_ROUNDS=5
DES_WORK_MS=0
DES_TRANSPORT=multicast
DES_NETEM=
DES_EXTRA_FLAGS="-DDES_SIMULATE_LOSS_PCT=5 -DDES_REQ_TIMEOUT_MS=100 -DDES_ACK_TIMEOUT_MS=100"
DES_TAG_SUFFIX=-loss5-fast

EXPECT_DEC_TOTAL=798
EXPECT_DEC_CYCLE1_TOTAL=190
EXPECT_OUTCOME=complete
