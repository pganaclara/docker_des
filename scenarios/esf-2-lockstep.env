# extended_small_factory: 2 supervisors -> 2 containers. Lockstep on, so every
# node replays the whole trace and it is checked event by event against the
# MONOLITHIC supervisor ("distributed vs MONOLITHIC sup.: PASS").
DES_PROBLEM=extended_small_factory
DES_NUM_NODES=2
DES_FAMILY=LMOD
DES_ROUNDS=5
DES_WORK_MS=0
DES_TRANSPORT=multicast
DES_NETEM=
DES_EXTRA_FLAGS=-DDES_BENCH_LOCKSTEP=1
DES_TAG_SUFFIX=-lockstep

# Cycle 1 is the single-board trace: 8 decryptions for the local-modular
# family on one ESP32-S3 (esp32_crypto README, benchmark table).
EXPECT_DEC_CYCLE1_TOTAL=8
EXPECT_MONO=PASS
EXPECT_OUTCOME=complete
